---
import { userCartItems } from '../models/session';

const userId = Astro.cookies.get('user-id')?.value;
const items = userId && userCartItems.has(userId)
  ? Array.from(userCartItems.get(userId).values())
  : [];
---
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Cart | Online Store</title>
</head>
<body>
  <h1>Your Cart</h1>
  {items.length === 0
    ? <p>Your cart is empty.</p>
    : <ul>{items.map((item: any) => <li>{item.name} x{item.count}</li>)}</ul>
  }
  <p><a href="/">Continue shopping</a></p>
</body>
</html>
