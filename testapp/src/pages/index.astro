---
const url = Astro.request.url;
const method = Astro.request.method;
const userAgent = Astro.request.headers.get('user-agent') ?? '(none)';
const now = new Date().toISOString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Netlify Runtime Test</title>
  </head>
  <body>
    <h1>Netlify Runtime Test</h1>
    <p>URL: {url}</p>
    <p>Method: {method}</p>
    <p>User-Agent: {userAgent}</p>
    <p>Server time: {now}</p>
    <ul>
      <li><a href="/greet/world">Dynamic route: /greet/world</a></li>
      <li><a href="/api/time">API: /api/time</a></li>
    </ul>
  </body>
</html>
