---
// 演示：从 BFF API 聚合数据
const res = await fetch(new URL('/api/products/1', Astro.url));
const data = res.ok ? await res.json() : null;
---
<html lang="zh">
<head><meta charset="UTF-8"><title>BFF Demo</title></head>
<body>
  <h1>BFF Demo</h1>
  {data?.product
    ? <p>{data.product.name} — ¥{data.product.price}
        {data.inventory ? ` | 库存 ${data.inventory.stock}` : ''}
      </p>
    : <p>服务不可用</p>
  }
</body>
</html>
